{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/accordion/**",
              "components/alert/**",
              "components/alert-dialog/**",
              "components/aspect-ratio/**",
              "components/avatar/**",
              "components/badge/**",
              "components/breadcrumb/**",
              "components/button/**",
              "components/button-group/**",
              "components/calendar/**",
              "components/card/**",
              "components/carousel/**",
              "components/charts/**",
              "components/code-block/**",
              "components/collapsible/**",
              "components/command-palette/**",
              "components/context-menu/**",
              "components/data-table/**",
              "components/date-picker/**",
              "components/divider/**",
              "components/dot/**",
              "components/drawer/**",
              "components/empty/**",
              "components/feed-indicator/**",
              "components/file-upload/**",
              "components/form-controls/**",
              "components/hover-card/**",
              "components/input/**",
              "components/input-group/**",
              "components/input-otp/**",
              "components/kbd/**",
              "components/loading/**",
              "components/menu/**",
              "components/menubar/**",
              "components/modal/**",
              "components/nav/**",
              "components/pagination/**",
              "components/popover/**",
              "components/resizable/**",
              "components/scroll-area/**",
              "components/select/**",
              "components/skeleton/**",
              "components/slider/**",
              "components/splash/**",
              "components/stat/**",
              "components/stepper/**",
              "components/tabs/**",
              "components/tag-input/**",
              "components/textarea/**",
              "components/toast/**",
              "components/toggle/**",
              "components/tooltip/**",
              "components/lc-wrap/**",
              "components/trade-table/**",
              "demos/**",
              "examples/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Roboto, JetBrains Mono."
      },
      {
        "selector": "Identifier[name=/^(idx|pos|el|desc|tok|cfg|btn|img|ctx|val|arr|obj|fn|num|str|err|res|req)$/]",
        "message": "Abbreviated identifier — use a full descriptive name (Rule 6: no abbreviations). e.g. index not idx, position not pos, element not el, description not desc, token not tok."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
